{:tasks
 {setup       {:doc "Install the toolchain and frontend dependencies"
               :do [{:sh "mise install"}
                    {:task web-install}]}

  fmt         {:doc "Format Go and frontend sources"
               :do [{:sh "golangci-lint fmt"}
                    {:task web-fmt}]}

  fmt-check   {:doc "Fail if any source is not formatted"
               :do [{:sh "golangci-lint fmt --diff"}
                    {:task web-fmt-check}]}

  lint        {:doc "Lint Go (golangci-lint) and frontend (oxlint, tsc)"
               :do [{:sh "golangci-lint run"}
                    {:task web-lint}]}

  test        {:doc "Run Go and frontend tests"
               :do [{:sh "go test -race ./..."}
                    {:task web-test}]}

  check       {:doc "Everything CI runs: fmt-check, lint, test, check-cli"
               :depends [fmt-check lint test check-cli]}

  check-cli   {:doc "Build the CLI without cgo, vet it, and fail if it links storage or the server"
               :do [{:sh "CGO_ENABLED=0 go build -tags cli -o /dev/null ./cmd/tracelet"}
                    {:sh "CGO_ENABLED=0 go vet -tags cli ./cmd/tracelet"}
                    {:sh "deps=$(CGO_ENABLED=0 go list -deps -tags cli ./cmd/tracelet) && ! printf '%s\\n' \"$deps\" | grep -E 'duckdb|sqlite|tracelet/internal/(app|web|duckdb|sqlite|httpapi)'"}]}

  build       {:doc "Build the frontend and the server binary into bin/"
               :depends [web-build]
               :do {:sh "go build -trimpath -ldflags \"-s -w -X main.version=$(git describe --tags --always --dirty)\" -o bin/tracelet ./cmd/tracelet"}}

  build-cli   {:doc "Build the CLI-only executable (no DuckDB, no cgo) into bin/cli/; GOOS and GOARCH cross-compile"
               :do {:sh "CGO_ENABLED=0 go build -tags cli -trimpath -ldflags \"-s -w -X main.version=$(git describe --tags --always --dirty)\" -o bin/cli/tracelet ./cmd/tracelet"}}

  docker      {:doc "Build the image around bin/tracelet and check its health (needs a binary built on glibc 2.41 or older, as CI builds)"
               :depends [build]
               :do {:sh "scripts/docker-smoke.sh"}}

  dev         {:doc "Run the server from source on :8080 (serves the last frontend build)"
               :do {:sh "go run ./cmd/tracelet serve --data-dir ./data"}}

  clean       {:doc "Remove build output"
               :do [{:sh "rm -rf bin"}
                    {:sh "find internal/web/dist -mindepth 1 ! -name .gitkeep -delete"}]}

  web-install {:doc "Install frontend dependencies from the lockfile"
               :cwd "web"
               :do {:sh "npm ci"}}

  web-dev     {:doc "Run the Vite dev server on :5173, proxying /api to :8080"
               :cwd "web"
               :do {:sh "npm run dev"}}

  web-build   {:doc "Build hashed frontend assets into internal/web/dist"
               :cwd "web"
               :do {:sh "npm run build"}}

  web-fmt     {:private? true
               :cwd "web"
               :do {:sh "npm run fmt"}}

  web-fmt-check {:private? true
                 :cwd "web"
                 :do {:sh "npm run fmt:check"}}

  web-lint    {:private? true
               :cwd "web"
               :do [{:sh "npm run lint"}
                    {:sh "npm run typecheck"}]}

  web-test    {:private? true
               :cwd "web"
               :do {:sh "npm test"}}}}
